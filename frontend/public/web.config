<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- inheritInChildApplications="false": /backend está montado como una IIS
       Application aparte (el backend .NET) dentro de este mismo sitio. Sin
       esto, IIS propaga esta regla de reescritura hacia esa subaplicación
       igual, y termina interceptando también sus requests. -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <rewrite>
        <rules>
          <!-- Dominio canónico: oviqcr.com (sin www) redirige a www.oviqcr.com.
               Sin esto, un usuario que entra por el dominio raíz carga la SPA
               igual (eso no pasa por CORS), pero toda llamada a la API queda
               bloqueada por el navegador porque el origen no está permitido
               en el backend — el login falla con un "Failed to fetch" que la
               UI muestra como si fueran credenciales incorrectas. -->
          <rule name="Canonical domain - apex a www" stopProcessing="true">
            <match url="(.*)" />
            <conditions>
              <add input="{HTTP_HOST}" pattern="^oviqcr\.com$" />
            </conditions>
            <action type="Redirect" url="https://www.oviqcr.com/{R:1}" redirectType="Permanent" appendQueryString="true" />
          </rule>

          <!-- SPA: rutas como /login, /tickets, etc. no son archivos reales en
               el servidor — las maneja React Router en el navegador. Sin esta
               regla, IIS busca un archivo/carpeta con ese nombre y da 404.
               Excluye /backend/api/ explícitamente: esa ruta la maneja la
               Application .NET del backend, no debe caer en el fallback de
               la SPA (eso reescribe el POST a index.html y el manejador de
               archivos estáticos responde 405 en vez del error real del
               backend). -->
          <rule name="SPA fallback" stopProcessing="true">
            <match url=".*" />
            <conditions logicalGrouping="MatchAll">
              <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
              <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
              <add input="{REQUEST_URI}" pattern="^/backend/api/" negate="true" />
            </conditions>
            <action type="Rewrite" url="/index.html" />
          </rule>
        </rules>
      </rewrite>
    </system.webServer>
  </location>

  <!-- index.html NUNCA debe cachearse: es el único archivo que indica qué
       bundle con hash (/assets/index-xxxx.js) usar. Los archivos con hash sí
       se cachean un año por defecto (correcto, son inmutables), pero si el
       navegador cachea index.html igual de largo, sigue sirviendo el bundle
       viejo para siempre después de cada deploy — un fix nunca le llega al
       usuario hasta que limpie caché a mano. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
