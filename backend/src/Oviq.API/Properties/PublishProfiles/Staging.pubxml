<Project>
  <!--
    dotnet publish -p:PublishProfile=Staging

    Publica en backend/publish con ASPNETCORE_ENVIRONMENT=Staging horneado en el
    web.config generado (así IIS lo levanta en modo Staging sin config manual en
    el servidor) y carga appsettings.Staging.json sobre el appsettings.json base.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>../../publish</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <SelfContained>false</SelfContained>
    <EnvironmentName>Staging</EnvironmentName>
  </PropertyGroup>
</Project>
